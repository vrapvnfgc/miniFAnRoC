{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"rootDir": "./src",
		"resolveJsonModule": true,
		"sourceMap": true,
		"paths": {
			"@shared": ["../shared/index.ts"]
		}
	},
	"include": ["src/**/*"]
}
