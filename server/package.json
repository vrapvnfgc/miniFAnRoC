{
	"name": "@mini-fanroc/server",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm wrangler dev",
		"seed:demo": "tsx src/seed/runDemoSeed.ts",
		"build": "pnpm wrangler deploy --dry-run --outdir ../build/server",
		"deploy": "pnpm wrangler deploy",
		"start": "pnpm wrangler dev",
		"types": "pnpm wrangler types --include-runtime false --env-file .dev.vars.example",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm types && tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.3.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260715.1",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.8",
		"@types/node": "^22.0.0",
		"@types/supertest": "^6.0.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"supertest": "^6.3.4",
		"tsx": "^4.7.1",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.58.1",
		"vitest": "^1.3.1",
		"wrangler": "4.112.0"
	}
}
