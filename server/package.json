{
	"name": "@mini-fanroc/server",
	"version": "0.0.1",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsup src/server.ts --format esm --clean --sourcemap --out-dir ../build",
		"start": "node ../build/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"mongoose": "^8.3.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.0.0",
		"@types/supertest": "^6.0.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"supertest": "^6.3.4",
		"tsup": "^8.0.2",
		"tsx": "^4.7.1",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.58.1",
		"vitest": "^1.3.1"
	}
}
